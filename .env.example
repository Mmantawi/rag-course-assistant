# RAG Course Assistant Configuration Template
# Copy this file to '.env' and fill in your details

# LLM choice (e.g. local Ollama model like llama3.2, or custom API models)
LLM_MODEL=llama3.2

# Embedding Model (e.g. local Ollama embedding model like mxbai-embed-large)
EMBEDDING_MODEL=mxbai-embed-large

# Chroma Vector Database Path
VECTOR_DB_PATH=vector_db/

# Storage Directories
PDF_FOLDER=data/pdfs/
PROCESSED_FOLDER=data/processed/

# Text Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval Parameters
TOP_K=10
SIMILARITY_THRESHOLD=0.75

# Gemini API Integration (optional, if using Gemini models)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API Integration (optional, if using Groq models)
# Get key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
