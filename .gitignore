# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & virtual envs
.env
.venv/
venv/
env/
ENV/

# Editors & IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Application Data & Databases (ignore all contents except .gitkeep)
data/pdfs/*
!data/pdfs/.gitkeep

data/processed/*
!data/processed/.gitkeep

vector_db/*
!vector_db/.gitkeep

# Other temporary or compiled files
*.sqlite3
*.pkl
*.log
data/pdfs_backup/
